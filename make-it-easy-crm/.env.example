# CRM Make It Easy - variables de entorno
# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos. La ruta es relativa a prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secreto para firmar las cookies JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Secreto opcional para cifrar las API keys guardadas en la base de datos.
# Si se deja vacio se usa AUTH_SECRET. No lo cambies despues de guardar conexiones:
# las claves existentes dejarian de poder descifrarse.
AI_KEYS_SECRET=""

# Puerto del servidor (npm run start usa 3005).
PORT=3005
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# IA. Puede configurarse aqui o desde Ajustes > Agentes y APIs.
OPENAI_API_KEY=""
# Modelo por defecto cuando solo se usa OPENAI_API_KEY (sin agente configurado).
OPENAI_MODEL="gpt-4o-mini"

# PageSpeed Insights (opcional, gratis). Sin esta clave el Radar funciona,
# pero la ficha no muestra notas de velocidad ni captura.
PAGESPEED_API_KEY=""

# Código ISO del país para geocodificar zonas del Radar (co = Colombia).
RADAR_COUNTRY="co"

# Auto-deploy (opcional)
GITHUB_TOKEN=""
DEPLOY_WEBHOOK_SECRET=""
APP_DIR=""
