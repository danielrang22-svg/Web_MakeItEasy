// Schema de producción — usa PostgreSQL
// Uso: npx prisma migrate deploy --schema=prisma/schema.production.prisma
//      npx prisma generate --schema=prisma/schema.production.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                 String   @id @default(uuid())
  titulo             String
  nombreContacto     String
  empresa            String
  valorEstimado      Float    @default(0)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  telefono           String
  email              String
  notas              String
  etapa              String   // "NUEVO" | "CONTACTADO" | "PROPUESTA" | "ACEPTADO" | "EN_DESARROLLO" | "EN_REVISION" | "GANADO" | "PERDIDO" | "COMPLETADO"
  origenLead         String   @default("Manual")
  
  // Custom Make It Easy fields
  sector             String?
  numEmpleados       String?
  procesoAAutomatizar String?
  planInteres        String?

  cotizaciones       Cotizacion[]
  proyectos          Proyecto[]

  @@index([email])
  @@index([fechaCreacion])
  @@map("leads")
}

model Empresa {
  id                    String   @id @default(uuid())
  nombre                String
  nit                   String
  direccion             String
  ciudad                String
  sector                String
  tamano                String
  telefono              String
  email                 String
  notas                 String
  
  fechaCreacion         DateTime @default(now())
  fechaActualizacion    DateTime @updatedAt

  contactos             Contacto[]

  @@map("empresas")
}

model Contacto {
  id                 String   @id @default(uuid())
  nombre             String
  cargo              String
  empresaId          String
  empresaNombre      String
  telefono           String
  telefono2          String
  email              String
  email2             String
  notas              String
  tags               String   // Comma separated list or JSON string
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  empresa            Empresa       @relation(fields: [empresaId], references: [id])
  interacciones      Interaccion[]

  @@index([empresaId])
  @@map("contactos")
}

model Interaccion {
  id          String   @id @default(uuid())
  contactoId  String
  tipo        String
  descripcion String
  fecha       DateTime @default(now())

  contacto    Contacto @relation(fields: [contactoId], references: [id])

  @@index([contactoId])
  @@map("interacciones")
}

model Cotizacion {
  id                 String   @id @default(uuid())
  codigo             String
  version            Int      @default(1)
  vendedor           String   @default("Daniel Rangel")
  fecha              DateTime @default(now())
  leadId             String?
  empresaNombre      String
  contactoNombre     String
  estado             String   // "BORRADOR" | "ENVIADA" | "APROBADA" | "RECHAZADA"
  
  // Rich Proposal Fields (Text content matching DOCX template)
  tituloPropuesta    String   @default("Propuesta Comercial: Ecosistema Digital Omnicanal")
  desafioNegocio     String?  // Section 1
  prerrequisitos     String?  // Section 2 (JSON String or text)
  arquitecturaJson   String?  // Section 3 (JSON array of component/function)
  fasesJson          String?  // Section 4 (JSON array of phases/pricing)
  checklistInicio    String?  // Section 6 (JSON String or text)
  
  // Totals & Recurring Fees (Section 5)
  totalProyectoCore  Float    @default(0)
  moduloOpcionalFee  Float    @default(0)
  feeMensual         Float    @default(0)
  feeMensualIncluye  String?  // Text description of what is included in the monthly fee
  moneda             String   @default("COP") // "COP" | "USD"
  
  observaciones      String?
  validez            String   @default("30 días")
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  lead               Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proyectos          Proyecto[]
  lineas             LineaCotizacion[]
  contratos          Contrato[]

  @@index([leadId])
  @@index([fechaCreacion])
  @@map("cotizaciones")
}

model LineaCotizacion {
  id             String     @id @default(uuid())
  cotizacionId   String
  referencia     String
  nombre         String
  proveedor      String
  costoUnd       Float
  precioUnd      Float
  cantidad       Int

  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@map("lineas_cotizacion")
}

model Proyecto {
  id                   String   @id @default(uuid())
  leadId               String?
  cotizacionId         String?
  titulo               String
  clienteNombre        String
  estado               String   // "DIAGNOSTICO" | "DISENO" | "IMPLEMENTACION" | "SOPORTE" | "EN_REVISION" | "ACEPTADO_CLIENTE" | "COMPLETADO"
  fechaInicio          DateTime @default(now())
  fechaEntregaEstimada DateTime?
  notas                String
  
  herramientasUsadas   String?  // Comma separated list of tools (n8n, Make, Stripe, etc.)
  githubRepo           String?  // e.g. "owner/repo"
  
  // Financial tracking
  valorTotal           Float    @default(0)
  moneda               String   @default("COP") // "COP", "USD", "EUR"
  
  fechaCreacion        DateTime @default(now())
  fechaActualizacion   DateTime @updatedAt

  ordenes              AutomationFlow[]
  ordenesProduccion    OrdenProduccion[]
  tareas               Tarea[]
  milestones           Milestone[]
  bitacora             BitacoraProyecto[]
  gastos               Gasto[]
  ingresos             Ingreso[]
  facturas             Factura[]
  lead                 Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  cotizacion           Cotizacion?        @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)
  contratos            Contrato[]

  @@index([leadId])
  @@index([cotizacionId])
  @@map("proyectos")
}

model Tarea {
  id            String    @id @default(uuid())
  proyectoId    String
  parentId      String?
  milestoneId   String?
  titulo        String
  descripcion   String?
  tipo          String    @default("development") // "product" | "development" | "bug"
  estado        String    @default("PENDIENTE")   // "BACKLOG" | "PENDIENTE" | "EN_PROGRESO" | "REVISION" | "QA" | "COMPLETADO"
  prioridad     Int       @default(0)             // 0=none 1=low 2=medium 3=high 4=urgent
  asignadoEmail String?
  estimado      Int?      // Story points
  githubBranch  String?   // e.g. "feat/login"
  githubPrNumber Int?     // associated PR number
  fechaLimite   DateTime?
  etiquetas     String?   // JSON array of strings
  completadaEn  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  proyecto      Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  parent        Tarea?          @relation("TareaSubtareas", fields: [parentId], references: [id])
  subtareas     Tarea[]         @relation("TareaSubtareas")
  milestone     Milestone?      @relation(fields: [milestoneId], references: [id])
  comentarios   ComentarioTarea[]

  @@index([proyectoId])
  @@index([parentId])
  @@map("tareas")
}

model Milestone {
  id            String    @id @default(uuid())
  proyectoId    String
  nombre        String
  descripcion   String?
  fechaObjetivo DateTime?
  completado    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  proyecto      Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tareas        Tarea[]

  @@index([proyectoId])
  @@map("milestones")
}

model ComentarioTarea {
  id          String   @id @default(uuid())
  tareaId     String
  autorNombre String
  autorEmail  String
  cuerpo      String
  githubCommentId String?
  createdAt   DateTime @default(now())

  tarea       Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([tareaId])
  @@map("comentarios_tareas")
}

model BitacoraProyecto {
  id            String   @id @default(uuid())
  proyectoId    String
  autorNombre   String
  autorEmail    String
  entrada       String
  tipo          String   @default("NOTA") // "NOTA", "ACTUALIZACION", "DECISION"
  createdAt     DateTime @default(now())

  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("bitacora_proyectos")
}

model AutomationFlow {
  id                 String   @id @default(uuid())
  proyectoId         String
  nombre             String
  estado             String   // "ACTIVO" | "PAUSADO" | "ERROR"
  tipo               String   // "WhatsApp AI Agent" | "CRM Sync" | "Invoicing Bot"
  ejecuciones24h     Int      @default(0)
  tasaExito          Float    @default(100.0)
  tiempoPromedio     Float    @default(0.0)
  notas              String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  proyecto           Proyecto @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId])
  @@map("automation_flows")
}

model OrdenProduccion {
  id                   String   @id @default(uuid())
  proyectoId           String
  proveedor            String
  estado               String
  fechaEntregaEstimada DateTime?
  costoTotalEstimado   Float
  notas                String
  fechaCreacion        DateTime @default(now())
  fechaActualizacion   DateTime @updatedAt

  items                ItemOrdenProduccion[]
  proyecto             Proyecto              @relation(fields: [proyectoId], references: [id])

  @@index([proyectoId])
  @@map("ordenes_produccion")
}

model ItemOrdenProduccion {
  id                   String   @id @default(uuid())
  ordenId              String
  lineaCotizacionId    String
  referencia           String
  nombre               String
  cantidad             Int
  costoUnd             Float
  totalCosto           Float
  notasInternas        String
  fechaEntregaEstimada DateTime?
  entregado            String // "SI" | "NO" | "PARCIALMENTE"
  cantidadEntregada    Int    @default(0)

  orden                OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@map("items_orden_produccion")
}

model Usuario {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?
  nombre             String
  rol                String   @default("ventas") // "admin" | "ventas" | "comercial"
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  gastos             Gasto[]

  @@map("usuarios")
}

model Proveedor {
  id                 String   @id @default(uuid())
  nombre             String   @unique
  nit                String
  especialidad       String
  telefono           String
  email              String
  notas              String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  gastos             Gasto[]

  @@map("proveedores")
}

model Producto {
  id                 String   @id @default(uuid())
  referencia         String   @unique
  nombre             String
  proveedor          String
  costoEstimado      Float
  precioSugerido     Float
  tipo               String   @default("servicio") // "producto" | "servicio"
  descripcion        String   @default("")          // Descripción larga opcional
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("productos")
}

model AiConnection {
  id           String   @id @default(uuid())
  nombre       String   // e.g. "OpenAI Principal", "DeepSeek API"
  proveedor    String   // "openai" | "deepseek" | "anthropic" | "gemini"
  modelo       String   // e.g. "gpt-4o-mini", "deepseek-chat"
  apiKey       String   // Stored as-is
  baseUrl      String?  // Optional custom base URL
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  agentes      Agent[]  // Relation with agents using this connection
  @@map("ai_connections")
}

model Agent {
  id           String   @id @default(uuid())
  nombre       String   // e.g. "Agente de Ventas y Cotizaciones"
  descripcion  String?  // Description of agent
  systemPrompt String   // Behaviors, rules, and prompt instructions
  activo       Boolean  @default(false) // Whether this agent is the active default
  connectionId String   // Associated API key / connection
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  conexion     AiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  
  @@map("agents")
}

model Gasto {
  id                 String   @id @default(uuid())
  concepto           String   // Ej: "Suscripción n8n", "Pago Freelancer"
  monto              Float
  moneda             String   @default("COP")
  fecha              DateTime @default(now())
  categoria          String   @default("GENERAL") // Ej: "SUSCRIPCION", "TERCEROS", "SOFTWARE"
  recurrente         Boolean  @default(false)     // Para saber si es un pago mensual/anual
  estado             String   @default("PAGADO")  // "PENDIENTE" | "PAGADO"
  notas              String?

  proyectoId         String?  
  proveedorId        String?  
  usuarioId          String?  

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  proyecto           Proyecto?  @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  proveedor          Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  usuario            Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([proveedorId])
  @@index([usuarioId])
  @@map("gastos")
}

model Ingreso {
  id                 String   @id @default(uuid())
  concepto           String   // Ej: "Abono 50% Inicio", "Pago Mensualidad"
  monto              Float
  moneda             String   @default("COP") // "COP", "USD", "EUR"
  trm                Float    @default(1.0)   // Tasa de cambio a COP en el momento del pago
  fecha              DateTime @default(now())
  metodoPago         String?  // Ej: "Transferencia", "Stripe", "Efectivo"
  estado             String   @default("COMPLETADO") // "PENDIENTE", "COMPLETADO"
  notas              String?

  proyectoId         String?  
  proyecto           Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([proyectoId])
  @@map("ingresos")
}

model Factura {
  id                 String   @id @default(uuid())
  proyectoId         String
  siigoId            String   @unique // ID retornado por Siigo
  numero             String   // Ej: FV-1-75 o FV-2-120
  tipo               String   // "FV-1" (No electrónica) o "FV-2" (Electrónica)
  valorTotal         Float
  saldoPendiente     Float    // Saldo restante por pagar
  estado             String   // "EMITIDA" | "ANULADA" | "PAGADA" | "PAGO_PARCIAL"
  url                String?
  fechaEmision       DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  // Anulaciones
  notaCreditoId      String?  // ID de la Nota de Crédito en Siigo si aplica
  notaCreditoNumero  String?  // Número de la Nota de Crédito en Siigo

  proyecto           Proyecto @relation(fields: [proyectoId], references: [id])
  pagos              Pago[]

  @@map("facturas")
}

model Pago {
  id                 String   @id @default(uuid())
  facturaId          String
  siigoId            String?  @unique // ID del Recibo de Caja (Voucher) en Siigo si se originó o sincronizó
  numeroRC           String?  // Número del Recibo de Caja en Siigo (ej. RC-1-65)
  monto              Float
  medioPagoId        String   // Ej: "13588" (Davivienda), "1675" (Efectivo)
  fechaPago          DateTime @default(now())
  origen             String   // "CRM" o "SIIGO"

  factura            Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("pagos")
}

model LogIntegracion {
  id            String   @id @default(uuid())
  servicio      String   // "SIIGO"
  accion        String   // "EMITIR_FACTURA", "REGISTRAR_PAGO", "CREAR_CLIENTE", "ANULAR_FACTURA"
  entidadId     String?  // ID local del recurso afectado
  exitoso       Boolean
  urlRequest    String
  payloadSent   String?  // JSON string
  responseBody  String?  // JSON string
  statusCode    Int?
  mensajeError  String?
  fechaCreacion DateTime @default(now())

  @@map("logs_integracion")
}

model Contrato {
  id                 String   @id @default(uuid())
  cotizacionId       String
  proyectoId         String?
  estado             String   @default("PENDIENTE") // "PENDIENTE" | "FIRMADO"
  trmAplicada        Float    @default(1.0)
  condicionesPago    String?
  contenidoPlantilla String   // Full text content with standard clauses and cotizacion description
  ipFirma            String?
  fechaFirma         DateTime?
  nombreFirmante     String?
  cedulaFirmante     String?
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  cotizacion         Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  proyecto           Proyecto?  @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([cotizacionId])
  @@index([proyectoId])
  @@map("contratos")
}
